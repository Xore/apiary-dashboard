# Environment for the dashboard server. See README.md → "Signing in and security".

# Shared secret with the backend. Required unless APIARY_ALLOW_UNAUTH_DEV=1.
SERVICE_TOKEN=

# Base URL of the APIARY backend tier (the canonical BFF's own variable, so
# one deployment configures both). Unset — the default — leaves the events &
# sessions slice answering from the mock.
# BACKEND_URL=http://127.0.0.1:8081

# Exactly 1 marks a local development instance (bun run dev sets it).
# Never set it on a deployed instance.
# APIARY_ALLOW_UNAUTH_DEV=1

# Exactly 1: the session cookie works over plain HTTP, so a dev server can
# be used by its LAN address. Development only (E-DEV-HTTP-COOKIE).
# APIARY_DEV_HTTP_COOKIE=1

# 1 skips sign-in: everyone is a fixture admin. Development only; the
# server refuses to boot with it otherwise (E-OIDC-DISABLED).
# OIDC_DISABLED=1

# The public origin, when a proxy changes the Host the server sees.
# EXTERNAL_URL=https://dashboard.example.test

# Mock only: make the session store and/or the identity provider stop
# answering, to see the outage paths (session-store,identity-provider).
# APIARY_MOCK_FAULTS=session-store

# Concurrent live streams (/api/live) before new ones are shed with 503.
# LIVE_MAX_STREAMS=500

# Event-loop p99 delay (ms) past which admission gates shed new requests.
# BFF_EVENT_LOOP_SHED_MS=250

# File for named events (sign-in outcomes), one JSON line each, for
# Filebeat. Capped at 25 MiB plus one rotated .1 generation. Unset: off.
# DASHBOARD_BFF_LOG_FILE=/var/log/dashboard/bff.jsonl

# Port of the Bun production server.
PORT=3000
