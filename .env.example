# Environment for the dashboard server. See README.md → "Signing in and security".

# Shared secret with the backend. Required unless APIARY_ALLOW_UNAUTH_DEV=1.
SERVICE_TOKEN=

# Exactly 1 marks a local development instance (bun run dev sets it).
# Never set it on a deployed instance.
# APIARY_ALLOW_UNAUTH_DEV=1

# 1 skips sign-in: everyone is a fixture admin. Development only; the
# server refuses to boot with it otherwise (E-OIDC-DISABLED).
# OIDC_DISABLED=1

# The public origin, when a proxy changes the Host the server sees.
# EXTERNAL_URL=https://dashboard.example.test

# Port of the Bun production server.
PORT=3000
